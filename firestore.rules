rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidReview(data) {
      return data.keys().hasOnly(['name', 'rating', 'message', 'createdAt'])
        && data.keys().hasAll(['name', 'rating', 'message', 'createdAt'])
        && data.name is string
        && data.name.size() >= 2 && data.name.size() <= 50
        && data.rating is int
        && data.rating >= 1 && data.rating <= 5
        && data.message is string
        && data.message.size() >= 10 && data.message.size() <= 600
        && data.createdAt == request.time;
    }

    match /reviews/{reviewId} {
      // svi mogu da čitaju recenzije, ali najviše 100 odjednom
      allow get: if true;
      allow list: if request.query.limit <= 100;

      // svako može da ostavi recenziju, samo ako su podaci ispravni
      allow create: if isValidReview(request.resource.data);

      // recenzije se posle objave ne menjaju i ne brišu preko sajta
      allow update, delete: if false;
    }

    // sve ostalo je zatvoreno
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
